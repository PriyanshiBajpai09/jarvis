{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@theme/*": ["../mobile/theme/*"],
      "@components/*": ["components/*"],
      "@screens/*": ["../mobile/screens/*"],
      "@hooks/*": ["../mobile/hooks/*"],
      "@services/*": ["services/*"],
      "@storage/*": ["storage/*"],
      "@voice/*": ["voice/*"],
      "@diagnostics/*": ["diagnostics/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}