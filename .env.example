# Copy this file to `.env` in the mobile/ project root and fill in real
# keys. Expo automatically exposes any variable prefixed EXPO_PUBLIC_ to
# the app bundle — no extra package required.

# Which provider services/aiService.ts should use: "gemini" | "groq" | "openai".
# Defaults to "gemini" if unset or invalid — this is the current active provider.
EXPO_PUBLIC_AI_PROVIDER=gemini

# Gemini — https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_key_here

# Groq — https://console.groq.com/keys (inactive until
# EXPO_PUBLIC_AI_PROVIDER=groq)
EXPO_PUBLIC_GROQ_API_KEY=your_groq_key_here

# OpenAI — https://platform.openai.com/api-keys (inactive until
# EXPO_PUBLIC_AI_PROVIDER=openai)
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_key_here