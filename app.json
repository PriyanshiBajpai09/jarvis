{
  "expo": {
    "name": "Jarvis MK-85",
    "slug": "jarvis-mk85",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#02040A",
    "assetBundlePatterns": ["**/*"],

    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow JARVIS to use the microphone for voice commands.",
          "speechRecognitionPermission": "Allow JARVIS to recognize your speech."
        }
      ]
    ],

    "android": {
      "softwareKeyboardLayoutMode": "resize"
    }
  }
}